{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "esn-frankfurt-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Served on its own subdomain of the site's domain, so the sign-in cookie
  // is "same-site" and works in every browser.
  "routes": [{ "pattern": "events-api.sourabh-bera.dev", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "esn-frankfurt",
      "database_id": "43e7b946-e721-4ebd-8855-23c641d6c72b",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    // Comma-separated list of frontend origins allowed to call the API (CORS).
    "ALLOWED_ORIGINS": "https://esnfrankfurt.teamtracker.sourabh-bera.dev,https://events.sourabh-bera.dev",
    // "Lax" when the frontend and API share a site (e.g. esn.example.org and
    // api.esn.example.org); "None" when they live on different sites.
    "COOKIE_SAMESITE": "Lax",
    // The website address, used for event links in the calendar feed.
    "SITE_URL": "https://esnfrankfurt.teamtracker.sourabh-bera.dev",
  },
}
