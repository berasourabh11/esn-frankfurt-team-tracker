# ── Server-only (never sent to the browser) ─────────────────────────────────
# Base URL of the ESN Frankfurt API (backend/, Cloudflare Worker), used to
# render event pages on the server. Leave empty to use the built-in mock data.
#   Local:      http://localhost:8787
#   Cloudflare: https://api.your-domain.org (or the *.workers.dev URL)
EVENTS_API_BASE_URL=
# Request timeout for API calls in milliseconds (default 8000).
EVENTS_API_TIMEOUT_MS=

# ── Public (inlined into the client bundle at build time) ──────────────────
# Canonical site URL, used for metadata, sitemaps and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The same API, as reached from browsers. Enables real sign-in (e-mail +
# password), member management and saving everything in the database.
# Leave empty for demo mode (team data is kept in the browser only).
NEXT_PUBLIC_API_BASE_URL=
# Optional: public iCalendar feed (e.g. https://api.example.org/api/events.ics).
# When set, the Subscribe dialog offers Google/Apple/Outlook subscription links.
NEXT_PUBLIC_CALENDAR_FEED_URL=
